---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="投稿" description="向藏书小刊提交文章、研究或资料。" noindex={true} showLanguageSwitch={false}>
  <section class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Submit</p>
        <h1>投稿</h1>
        <p>投稿会直接进入站内审核队列，不会自动公开。审核时联系方式仅供站长联系，不会显示在网站上。</p>
      </div>
    </div>

    <div class="submit-layout">
      <form class="submit-form" id="submission-form">
        <input class="honeypot" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input name="startedAt" type="hidden" />
        <div class="form-row">
          <label>
            作者或称呼
            <input name="author" type="text" maxlength="60" placeholder="用于署名或联系" required />
          </label>
          <label>
            联系方式 <span class="optional">选填，不公开</span>
            <input name="contact" type="text" maxlength="120" placeholder="邮箱、微信或其他方式" />
          </label>
        </div>
        <label>
          投稿栏目
          <select name="section">
            <option value="research">研究</option>
            <option value="essays">随笔动态</option>
            <option value="blog">博客</option>
            <option value="resources">资料</option>
            <option value="bookmarks">收藏</option>
            <option value="downloads">下载</option>
          </select>
        </label>

        <label>
          标题
          <input name="title" type="text" maxlength="120" placeholder="给投稿起一个清楚的标题" required />
        </label>

        <label>
          一句话摘要
          <textarea name="description" rows="3" maxlength="300" placeholder="用一两句话说明这篇内容是什么" required></textarea>
        </label>

        <div class="form-row">
          <label>
            语言
            <select name="language">
              <option value="zh">中文</option>
              <option value="en">English</option>
            </select>
          </label>

          <label>
            标签
          <input name="tags" type="text" maxlength="200" placeholder="例如：随笔, 工具, 阅读" />
          </label>
        </div>

        <label>
          外部链接或下载地址
          <input name="url" type="url" placeholder="研究可填代码链接，收藏和下载可填写链接，其他栏目可留空" />
        </label>

        <label>
          研究附件
          <textarea name="attachments" rows="4" maxlength="2000" placeholder="研究投稿可填写附件公开链接，每行一个：PDF | 研究说明 | https://example.com/file.pdf"></textarea>
        </label>

        <div class="notice compact-notice">
          <strong>安全提醒</strong>
          <p>请不要提交隐私文件、账号密钥、未授权转载内容或无法公开的附件。所有链接和正文都会由站长人工审核后再发布。</p>
        </div>

        <label>
          正文
          <textarea name="body" rows="14" maxlength="30000" placeholder="在这里写正文，支持 Markdown" required></textarea>
        </label>

        <div class="submit-actions">
          <button class="primary-button" type="submit" id="submit-entry">提交审核</button>
          <button type="button" id="copy-submission">复制 Markdown 备份</button>
        </div>

        <p class="form-status" id="submission-status" aria-live="polite"></p>
      </form>

      <aside class="submission-preview">
        <div class="preview-head">
          <h2>投稿预览</h2>
          <p>站长审核后会把这份内容整理进网站。</p>
        </div>
        <pre><code id="markdown-preview"></code></pre>
      </aside>
    </div>
  </section>

  <section class="container">
    <div class="grid">
      <article class="card">
        <h3>审核流程</h3>
        <p>投稿会进入站内待审核列表，站长确认内容、格式、来源和附件安全后再发布。</p>
      </article>
      <article class="card">
        <h3>归档隐藏</h3>
        <p>审核台可以通过或拒绝投稿；通过后再由站长整理为正式文章发布。</p>
      </article>
      <article class="card">
        <h3>附件说明</h3>
        <p>研究附件第一版请填写公开链接，正式文件由站长审核后再放入网站后台或仓库。</p>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector("#submission-form");
  const preview = document.querySelector("#markdown-preview");
  const copyButton = document.querySelector("#copy-submission");
  const submitButton = document.querySelector("#submit-entry");
  const status = document.querySelector("#submission-status");
  const startedAt = form.elements.namedItem("startedAt");
  startedAt.value = String(Date.now());


  function today() {
    return new Date().toISOString().slice(0, 10);
  }

  function yamlString(value) {
    return `"${String(value).replaceAll("\\", "\\\\").replaceAll('"', '\\"')}"`;
  }

  function tagsList(value) {
    return String(value)
      .split(/[,，]/)
      .map((tag) => tag.trim())
      .filter(Boolean);
  }

  function attachmentsList(value) {
    return String(value)
      .split(/\n+/)
      .map((line) => line.trim())
      .filter(Boolean)
      .map((line) => {
        const [type = "File", label = "附件", url = ""] = line.split("|").map((part) => part.trim());
        return { type, label, url };
      })
      .filter((item) => item.url);
  }

  function markdownFromForm() {
    const data = new FormData(form);
    const section = data.get("section") || "essays";
    const title = String(data.get("title") || "").trim();
    const description = String(data.get("description") || "").trim();
    const language = String(data.get("language") || "zh");
    const tags = tagsList(data.get("tags") || "");
    const attachments = attachmentsList(data.get("attachments") || "");
    const url = String(data.get("url") || "").trim();
    const body = String(data.get("body") || "").trim();
    const urlField = section === "downloads" ? "fileUrl" : section === "research" ? "codeUrl" : "externalUrl";
    const optionalUrl = url ? `\n${urlField}: ${yamlString(url)}` : "";
    const researchFields =
      section === "research"
        ? `\nauthors: []\nresearchStatus: "preprint"\nvenue: ""\ndoi: ""\ncitation: ""\nattachments:${attachments.length ? attachments.map((item) => `\n  - label: ${yamlString(item.label)}\n    type: ${yamlString(item.type)}\n    url: ${yamlString(item.url)}`).join("") : " []"}`
        : "";

    return `---
title: ${yamlString(title || "未命名投稿")}
description: ${yamlString(description || "待补充摘要")}
date: "${today()}"
status: "archived"
featured: false
language: "${language}"
tags: [${tags.map(yamlString).join(", ")}]${optionalUrl}${researchFields}
---

${body || "正文写在这里。"}`;
  }

  function updatePreview() {
    const markdown = markdownFromForm();
    preview.textContent = markdown;
  }

  form.addEventListener("input", updatePreview);
  form.addEventListener("change", updatePreview);

  copyButton.addEventListener("click", async () => {
    await navigator.clipboard.writeText(markdownFromForm());
    status.textContent = "已复制 Markdown，可以粘贴到 GitHub Issue 或后台。";
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    submitButton.disabled = true;
    status.textContent = "正在提交……";
    const payload = Object.fromEntries(new FormData(form).entries());
    try {
      const response = await fetch("/api/submissions", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload)
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "提交失败");
      status.textContent = data.message;
      form.reset();
      startedAt.value = String(Date.now());
      updatePreview();
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : "提交失败，请稍后重试。";
    } finally {
      submitButton.disabled = false;
    }
  });

  updatePreview();
</script>
