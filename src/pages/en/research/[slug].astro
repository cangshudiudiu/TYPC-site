---
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = import.meta.glob("../../../content-en/research/*.md", { eager: true });
  const originals = import.meta.glob("../../../content/research/*.md", { eager: true });
  const originalSlugs = new Set(Object.keys(originals).map((path) => path.split("/").pop()?.replace(/\.md$/, "")));
  return Object.entries(entries).filter(([, entry]) => (entry as any).frontmatter.status !== "archived").map(([path, entry]) => ({
    params: { slug: path.split("/").pop()?.replace(/\.md$/, "") }, props: { entry, hasTranslation: originalSlugs.has(path.split("/").pop()?.replace(/\.md$/, "")) }
  }));
}

const { entry, hasTranslation } = Astro.props;
const { Content, frontmatter } = entry;
---

<BaseLayout locale="en" title={frontmatter.title} description={frontmatter.description} showLanguageSwitch={hasTranslation}>
  <article class="article">
    <header>
      <p class="eyebrow">Research</p><h1>{frontmatter.title}</h1><p class="lead">{frontmatter.description}</p>
      <p class="meta">{frontmatter.date} · EN{frontmatter.researchStatus ? ` · ${frontmatter.researchStatus}` : ""}</p>
      {frontmatter.authors?.length ? <p class="byline">{frontmatter.authors.join(", ")}</p> : null}
    </header>
    <section class="research-meta">
      {frontmatter.venue ? <p><strong>Venue/source: </strong>{frontmatter.venue}</p> : null}
      {frontmatter.doi ? <p><strong>DOI: </strong><a href={`https://doi.org/${frontmatter.doi}`}>{frontmatter.doi}</a></p> : null}
      {frontmatter.codeUrl ? <p><strong>Code: </strong><a href={frontmatter.codeUrl}>{frontmatter.codeUrl}</a></p> : null}
    </section>
    {frontmatter.attachments?.length ? (
      <section class="attachment-panel"><h2>Attachments</h2><div class="attachment-list">{frontmatter.attachments.map((attachment) => <a class="attachment-link" href={attachment.url}><span>{attachment.type ?? "file"}</span>{attachment.label}</a>)}</div></section>
    ) : null}
    <div class="article-content"><Content /></div>
    {frontmatter.citation ? <section class="citation-box"><h2>Citation</h2><p>{frontmatter.citation}</p></section> : null}
  </article>
</BaseLayout>
