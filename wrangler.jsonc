{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typc-site",
  "compatibility_date": "2026-05-22",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "secrets": {
    "required": [
      "ADMIN_TOKEN"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "typc-site-content",
      "database_id": "replace-after-running-wrangler-d1-create",
      "migrations_dir": "migrations"
    }
  ],
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  }
}
